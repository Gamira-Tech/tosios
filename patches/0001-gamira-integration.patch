@@ -0,0 +1,332 @@
+import { GAMIRA_API, PLATFORM_URL as AUTH_API } from './clientConfig';
+/**
+ * Optional NAT-traversal tunnel for the game connection.
+ *
+ * Active only when the matched session advertises ice_servers, i.e. when the
+ * deployment runs a TURN mode. Otherwise nothing here runs and the client connects
+ * over its normal WebSocket — the direct path stays the default.
+ *
+ * A browser cannot spawn the ice-proxy the native demos use, and it does not need
+ * to: it already has a full ICE stack. So this opens an RTCPeerConnection against
+ * the same sidecar those proxies talk to, over a reliable-ordered RTCDataChannel
+ * (the sidecar forwards it to the game server's TCP port — see GAMIRA_ICE_STREAM).
+ *
+ * colyseus.js 0.14 has no way to inject a transport, so rather than fork it, this
+ * temporarily replaces window.WebSocket with a shim that is DataChannel-backed for
+ * the game server's URL only and passes every other URL straight through. colyseus
+ * then rides the tunnel without knowing it exists.
+ */
+
+/** Same endpoint the rest of the client uses; signaling runs against gamira. */
+
+export interface IceServer {
+    urls: string[];
+    username?: string;
+    credential?: string;
+}
+
+/**
+ * True when this session can and should use a tunnel.
+ *
+ * The deployment's TURN_MODE is the switch: gamira advertises ice_servers on the
+ * session exactly when a mode is active, so their presence IS the configuration
+ * arriving at runtime — no build flag and no second endpoint to keep in sync.
+ * localStorage.gamiraIce='0' forces one window back onto the direct path, which is
+ * what comparing the two paths side by side needs.
+ */
+export function isIceEnabled(iceServers?: IceServer[]): boolean {
+    if (!iceServers || iceServers.length === 0) return false;
+    try {
+        return window.localStorage.getItem('gamiraIce') !== '0';
+    } catch {
+        // Storage can be unavailable (private mode); the deployment's choice stands.
+        return true;
+    }
+}
+
+/**
+ * Negotiates the tunnel and patches window.WebSocket so a connection to serverUrl
+ * rides it. Returns a function that removes the patch and closes the tunnel, or
+ * null when no tunnel could be established.
+ *
+ * Returning null is not a failure to handle: the caller connects directly instead. A
+ * relay is a fallback path, so failing to build one must never stop a player who
+ * could have connected anyway.
+ */
+export async function openIceTunnel(opts: {
+    apiBase: string;
+    token: string;
+    sessionId: string;
+    serverUrl: string;
+    iceServers: IceServer[];
+    timeoutMs?: number;
+}): Promise<(() => void) | null> {
+    const { apiBase, token, sessionId, serverUrl, iceServers } = opts;
+    const timeoutMs = opts.timeoutMs ?? 25000;
+
+    const connID = newConnID();
+
+    let pc: RTCPeerConnection;
+    let channel: RTCDataChannel;
+    try {
+        pc = new RTCPeerConnection({
+            iceServers: iceServers.map((s) => ({
+                urls: s.urls,
+                username: s.username || undefined,
+                credential: s.credential || undefined,
+            })),
+        });
+        // Reliable and ordered: this carries what the WebSocket used to, and colyseus
+        // assumes a stream that neither drops nor reorders.
+        channel = pc.createDataChannel('gamira', { ordered: true });
+        channel.binaryType = 'arraybuffer';
+    } catch (err) {
+        // A browser that rejects the ICE server list throws here, synchronously.
+        // Outside the try below that would escape into the caller's own catch and
+        // strand a player who could have connected directly.
+        // eslint-disable-next-line no-console
+        console.warn('ice: cannot build a peer connection, connecting directly:', err);
+        return null;
+    }
+
+    try {
+        const offer = await pc.createOffer();
+        await pc.setLocalDescription(offer);
+        // Wait for gathering rather than trickling: one exchange carrying the
+        // complete description needs no second signaling channel.
+        await gatheringComplete(pc, timeoutMs);
+
+        const answer = await exchange(apiBase, token, sessionId, connID, pc.localDescription!, timeoutMs);
+        await pc.setRemoteDescription(answer);
+        await channelOpen(channel, timeoutMs);
+    } catch (err) {
+        // eslint-disable-next-line no-console
+        console.warn('ice: tunnel unavailable, connecting directly:', err);
+        pc.close();
+        return null;
+    }
+
+    const restore = installWebSocketShim(serverUrl, channel);
+    return () => {
+        restore();
+        try {
+            channel.close();
+        } finally {
+            pc.close();
+        }
+    };
+}
+
+/**
+ * Runs one control-plane request against the game server through gamira, and
+ * returns its parsed JSON.
+ *
+ * The tunnel carries the game server's port and nothing else. colyseus needs a
+ * seat reservation over HTTP before that port accepts a WebSocket, and a client
+ * that cannot reach the game server directly cannot make that call — so it goes
+ * through gamira, which is the endpoint the Cloudflare Tunnel exposes.
+ */
+export async function gameServerControl(
+    apiBase: string,
+    token: string,
+    sessionId: string,
+    path: string,
+    body: unknown,
+): Promise<any> {
+    const resp = await fetch(`${apiBase.replace(/\/$/, '')}/sessions/${sessionId}/gameserver/control`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'x-token': token },
+        body: JSON.stringify({ path, body: JSON.stringify(body) }),
+    });
+    if (!resp.ok) throw new Error(`gameserver/control returned ${resp.status}`);
+    const relayed = await resp.json();
+    // The game server's own status is reported inside the payload, so a relayed
+    // rejection is not mistaken for a successful handshake.
+    if (relayed.status >= 400) {
+        throw new Error(`game server answered ${relayed.status}: ${String(relayed.body).slice(0, 200)}`);
+    }
+    return JSON.parse(relayed.body);
+}
+
+/**
+ * Identifies this tunnel among the ones the same account has open. Every window
+ * of one browser profile shares the login, so keying signaling by player alone
+ * makes two windows negotiate against each other's answer — one gets a tunnel
+ * and the rest fall back. The native ice-proxy sends the same field.
+ */
+function newConnID(): string {
+    const c = window.crypto as Crypto & { randomUUID?: () => string };
+    if (c?.randomUUID) return c.randomUUID();
+    const b = new Uint8Array(16);
+    window.crypto.getRandomValues(b);
+    return Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
+}
+
+/** POSTs the offer to gamira and returns the sidecar's answer. */
+async function exchange(
+    apiBase: string,
+    token: string,
+    sessionId: string,
+    connID: string,
+    local: RTCSessionDescription,
+    timeoutMs: number,
+): Promise<RTCSessionDescriptionInit> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), timeoutMs + 5000);
+    try {
+        // Base64-wrapped JSON, matching what the Go proxies exchange, so both client
+        // kinds negotiate against one sidecar implementation.
+        const blob = btoa(JSON.stringify({ type: local.type, sdp: local.sdp }));
+        const resp = await fetch(`${apiBase.replace(/\/$/, '')}/sessions/${sessionId}/ice/offer`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json', 'x-token': token },
+            body: JSON.stringify({ offer: blob, conn_id: connID }),
+            signal: controller.signal,
+        });
+        if (!resp.ok) throw new Error(`ice/offer returned ${resp.status}`);
+        const { answer } = await resp.json();
+        if (!answer) throw new Error('gamira returned an empty ICE answer');
+        return JSON.parse(atob(answer));
+    } finally {
+        clearTimeout(timer);
+    }
+}
+
+function gatheringComplete(pc: RTCPeerConnection, timeoutMs: number): Promise<void> {
+    if (pc.iceGatheringState === 'complete') return Promise.resolve();
+    return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('ICE gathering timed out')), timeoutMs);
+        pc.addEventListener('icegatheringstatechange', function onChange() {
+            if (pc.iceGatheringState === 'complete') {
+                clearTimeout(timer);
+                pc.removeEventListener('icegatheringstatechange', onChange);
+                resolve();
+            }
+        });
+    });
+}
+
+function channelOpen(channel: RTCDataChannel, timeoutMs: number): Promise<void> {
+    if (channel.readyState === 'open') return Promise.resolve();
+    return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('data channel did not open')), timeoutMs);
+        channel.onopen = () => {
+            clearTimeout(timer);
+            resolve();
+        };
+        channel.onerror = () => {
+            clearTimeout(timer);
+            reject(new Error('data channel failed'));
+        };
+    });
+}
+
+/**
+ * Replaces window.WebSocket with one that returns a DataChannel-backed socket for
+ * serverUrl and the real thing for anything else. Returns a restore function; the
+ * patch is deliberately narrow and short-lived so nothing else in the page changes
+ * behaviour while a match is running.
+ */
+function installWebSocketShim(serverUrl: string, channel: RTCDataChannel): () => void {
+    const RealWebSocket = window.WebSocket;
+    const host = hostOf(serverUrl);
+
+    function PatchedWebSocket(this: any, url: string, protocols?: string | string[]) {
+        if (hostOf(url) === host) {
+            return new DataChannelSocket(channel, url) as any;
+        }
+        return new RealWebSocket(url, protocols as any);
+    }
+    PatchedWebSocket.prototype = RealWebSocket.prototype;
+    (PatchedWebSocket as any).CONNECTING = RealWebSocket.CONNECTING;
+    (PatchedWebSocket as any).OPEN = RealWebSocket.OPEN;
+    (PatchedWebSocket as any).CLOSING = RealWebSocket.CLOSING;
+    (PatchedWebSocket as any).CLOSED = RealWebSocket.CLOSED;
+
+    (window as any).WebSocket = PatchedWebSocket;
+    return () => {
+        (window as any).WebSocket = RealWebSocket;
+    };
+}
+
+function hostOf(url: string): string {
+    try {
+        return new URL(url.replace(/^ws/, 'http')).host;
+    } catch {
+        return url;
+    }
+}
+
+/**
+ * The subset of the WebSocket API colyseus.js uses, backed by a data channel:
+ * binaryType, readyState, the four handler properties, send and close. Enough for
+ * colyseus's transport, and not a general-purpose WebSocket.
+ */
+class DataChannelSocket {
+    static readonly CONNECTING = 0;
+    static readonly OPEN = 1;
+    static readonly CLOSING = 2;
+    static readonly CLOSED = 3;
+
+    binaryType: BinaryType = 'arraybuffer';
+    onopen: ((ev: any) => void) | null = null;
+    onmessage: ((ev: any) => void) | null = null;
+    onclose: ((ev: any) => void) | null = null;
+    onerror: ((ev: any) => void) | null = null;
+
+    readonly url: string;
+    readonly protocol = '';
+
+    private readonly channel: RTCDataChannel;
+
+    constructor(channel: RTCDataChannel, url: string) {
+        this.channel = channel;
+        this.url = url;
+        channel.binaryType = 'arraybuffer';
+        channel.onmessage = (ev) => this.onmessage?.({ data: ev.data });
+        channel.onclose = () => this.onclose?.({ code: 1000, reason: 'data channel closed', wasClean: true });
+        channel.onerror = (ev) => this.onerror?.(ev);
+        // The tunnel is already up by the time this is constructed, but colyseus
+        // attaches its handler after construction — so announce on the next tick
+        // rather than synchronously, or the open event is missed.
+        setTimeout(() => this.onopen?.({}), 0);
+    }
+
+    get readyState(): number {
+        switch (this.channel.readyState) {
+            case 'connecting':
+                return DataChannelSocket.CONNECTING;
+            case 'open':
+                return DataChannelSocket.OPEN;
+            case 'closing':
+                return DataChannelSocket.CLOSING;
+            default:
+                return DataChannelSocket.CLOSED;
+        }
+    }
+
+    send(data: ArrayBufferLike | ArrayBufferView | string): void {
+        if (this.channel.readyState !== 'open') return;
+        this.channel.send(data as any);
+    }
+
+    close(): void {
+        this.channel.close();
+    }
+
+    addEventListener(type: string, listener: (ev: any) => void): void {
+        if (type === 'open') this.onopen = listener;
+        else if (type === 'message') this.onmessage = listener;
+        else if (type === 'close') this.onclose = listener;
+        else if (type === 'error') this.onerror = listener;
+    }
+
+    removeEventListener(type: string): void {
+        if (type === 'open') this.onopen = null;
+        else if (type === 'message') this.onmessage = null;
+        else if (type === 'close') this.onclose = null;
+        else if (type === 'error') this.onerror = null;
+    }
+}
+
+export { GAMIRA_API } from './clientConfig';
