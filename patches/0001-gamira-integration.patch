diff --git a/TOSIOS/packages/client/src/api/authClient.ts b/TOSIOS/packages/client/src/api/authClient.ts
new file mode 100644
index 0000000000000000000000000000000000000000..693848fbe0f34398aa1d4b3bf871a03ede2b43e6
--- /dev/null
+++ b/TOSIOS/packages/client/src/api/authClient.ts
@@ -0,0 +1,204 @@
+import { GAMIRA_API, PLATFORM_URL as AUTH_API } from './clientConfig';
+
+let redirecting = false;
+
+export function getToken(): string | null {
+    return localStorage.getItem('x-token');
+}
+
+function setToken(value: string): void {
+    localStorage.setItem('x-token', value);
+}
+
+function removeToken(): void {
+    localStorage.removeItem('x-token');
+}
+
+export async function logout(): Promise<void> {
+    const token = getToken();
+    const ticketId = sessionStorage.getItem('ticket-id');
+    if (token && ticketId) {
+        await fetch(`${GAMIRA_API}/matchmaking/tickets/${ticketId}`, {
+            method: 'DELETE',
+            headers: { 'x-token': token },
+        }).catch(() => {});
+    }
+    sessionStorage.removeItem('ticket-id');
+    sessionStorage.removeItem('tab-id');
+    removeToken();
+    localStorage.removeItem('auth-keypair');
+    localStorage.removeItem(OAUTH_LEADER_KEY);
+    window.location.href = window.location.pathname;
+}
+
+export function getQueryParam(param: string): string | null {
+    const value = new URLSearchParams(window.location.search).get(param);
+    return value ? decodeURIComponent(value) : null;
+}
+
+async function generateKeyPair(): Promise<{ publicKeyPEM: string; privateKeyPEM: string }> {
+    const keyPair = await window.crypto.subtle.generateKey(
+        { name: 'RSA-OAEP', modulusLength: 2048, publicExponent: new Uint8Array([0x01, 0x00, 0x01]), hash: 'SHA-256' },
+        true,
+        ['encrypt', 'decrypt'],
+    );
+    const exportKey = async (key: CryptoKey, isPublic: boolean) => {
+        const exported = await window.crypto.subtle.exportKey(isPublic ? 'spki' : 'pkcs8', key);
+        const b64 = window.btoa(String.fromCharCode(...new Uint8Array(exported)));
+        const header = isPublic ? 'PUBLIC KEY' : 'PRIVATE KEY';
+        return `-----BEGIN ${header}-----\n${b64.match(/.{1,64}/g)!.join('\n')}\n-----END ${header}-----`;
+    };
+    return {
+        publicKeyPEM: await exportKey(keyPair.publicKey, true),
+        privateKeyPEM: await exportKey(keyPair.privateKey, false),
+    };
+}
+
+async function decryptText(privateKeyPEM: string, encryptedB64: string): Promise<string> {
+    const b64 = privateKeyPEM
+        .split('\n')
+        .filter((l) => !l.includes('-----'))
+        .join('');
+    const keyBuffer = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+    const privateKey = await crypto.subtle.importKey(
+        'pkcs8',
+        keyBuffer,
+        { name: 'RSA-OAEP', hash: 'SHA-256' },
+        false,
+        ['decrypt'],
+    );
+    const encBuf = Uint8Array.from(atob(encryptedB64), (c) => c.charCodeAt(0)).buffer;
+    const decBuf = await crypto.subtle.decrypt({ name: 'RSA-OAEP' }, privateKey, encBuf);
+    return new TextDecoder().decode(decBuf);
+}
+
+const OAUTH_LEADER_KEY = 'oauth-leader';
+const OAUTH_LEADER_TTL_MS = 300_000;
+const OAUTH_LEADER_WAIT_MS = 300_000;
+
+(function cleanStaleLeader() {
+    const raw = localStorage.getItem(OAUTH_LEADER_KEY);
+    if (!raw) return;
+    const ts = parseInt(raw, 10);
+    if (Number.isNaN(ts) || Date.now() - ts >= OAUTH_LEADER_TTL_MS) {
+        localStorage.removeItem(OAUTH_LEADER_KEY);
+    }
+})();
+
+function claimOAuthLeader(): boolean {
+    const now = Date.now();
+    const raw = localStorage.getItem(OAUTH_LEADER_KEY);
+    if (raw) {
+        const ts = parseInt(raw, 10);
+        if (!Number.isNaN(ts) && now - ts < OAUTH_LEADER_TTL_MS) {
+            return false;
+        }
+    }
+    const stamp = `${now}-${Math.random().toString(36).slice(2, 10)}`;
+    localStorage.setItem(OAUTH_LEADER_KEY, stamp);
+    const readBack = localStorage.getItem(OAUTH_LEADER_KEY);
+    if (readBack !== stamp) {
+        return false;
+    }
+    return true;
+}
+
+function clearOAuthLeader(): void {
+    localStorage.removeItem(OAUTH_LEADER_KEY);
+}
+
+async function waitForLeaderToken(): Promise<string | null> {
+    const deadline = Date.now() + OAUTH_LEADER_WAIT_MS;
+    while (Date.now() < deadline) {
+        await new Promise((r) => setTimeout(r, 500));
+        const t = getToken();
+        if (t) return t;
+        const raw = localStorage.getItem(OAUTH_LEADER_KEY);
+        if (!raw) return null;
+        const ts = parseInt(raw, 10);
+        if (Number.isNaN(ts) || Date.now() - ts >= OAUTH_LEADER_TTL_MS) {
+            localStorage.removeItem(OAUTH_LEADER_KEY);
+            return null;
+        }
+    }
+    clearOAuthLeader();
+    return null;
+}
+
+// Try to obtain a token without redirecting. Returns null if none available.
+export async function tryGetToken(): Promise<string | null> {
+    const existing = getToken();
+    if (existing) {
+        try {
+            const res = await fetch(`${AUTH_API}/api/v1/token/refresh`, { headers: { 'x-token': existing } });
+            if (res.ok) {
+                const token = await res.json();
+                setToken(token);
+                return token;
+            }
+        } catch (_e) {
+            // ignore, fall through to remove stale token
+        }
+        removeToken();
+    }
+
+    const nonce = getQueryParam('nonce');
+    if (nonce) {
+        const keys = JSON.parse(localStorage.getItem('auth-keypair') || 'null');
+        if (keys) {
+            const decrypted = await decryptText(keys.privateKeyPEM, atob(nonce));
+            const res = await fetch(`${AUTH_API}/api/v1/token/issue`, { headers: { 'x-nonce': decrypted } });
+            if (res.ok) {
+                const token = await res.json();
+                setToken(token);
+                clearOAuthLeader();
+                window.history.replaceState(null, '', window.location.pathname);
+                return token;
+            } else {
+                clearOAuthLeader();
+            }
+        } else {
+            clearOAuthLeader();
+        }
+    }
+
+    return null;
+}
+
+// Wait briefly for another tab to produce a token. Returns null on timeout.
+export async function waitForOtherTab(): Promise<string | null> {
+    const raw = localStorage.getItem(OAUTH_LEADER_KEY);
+    if (!raw) return null;
+    const ts = parseInt(raw, 10);
+    if (Number.isNaN(ts) || Date.now() - ts >= OAUTH_LEADER_TTL_MS) return null;
+    return waitForLeaderToken();
+}
+
+// User-triggered sign-in. Claims leader and redirects to GitHub.
+export async function signIn(): Promise<void> {
+    if (redirecting) return;
+    if (!claimOAuthLeader()) {
+        const t = await waitForLeaderToken();
+        if (t) {
+            window.location.reload();
+            return;
+        }
+        if (!claimOAuthLeader()) return;
+    }
+
+    let keys = JSON.parse(localStorage.getItem('auth-keypair') || 'null');
+    if (!keys) {
+        keys = await generateKeyPair();
+        localStorage.setItem('auth-keypair', JSON.stringify(keys));
+    }
+    const encodedKey = btoa(keys.publicKeyPEM);
+    const nonceRes = await fetch(`${AUTH_API}/api/v1/nonce`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ publicKey: encodedKey }),
+    });
+    const rawNonce = await nonceRes.json();
+    const state = btoa(JSON.stringify({ nonce: rawNonce, authenticationType: 'web' }));
+    redirecting = true;
+    window.location.href = `${AUTH_API}/api/v1/auth/github?state=${state}`;
+}
