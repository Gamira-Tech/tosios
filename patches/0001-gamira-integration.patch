@@ -0,0 +1,141 @@
+import { GAMIRA_API, PLATFORM_URL as AUTH_API } from './clientConfig';
+import type { IceServer } from './iceTunnel';
+const GAME_MODE_ID = 'gm_tosios';
+
+export interface MatchmakingTicket {
+    ticket_id: string;
+    status: 'queued' | 'matched' | 'cancelled';
+    // ice_servers is present only when the deployment runs a TURN mode; the
+    // optional tunnel uses it, and the direct ip/port stays the default path.
+    connection?: { ip: string; port: number; ice_servers?: IceServer[] };
+    team_id?: string;
+    session_id?: string;
+    region_id?: string;
+}
+
+// region_id -> public API base URL, from GET /regions. In a multi-location
+// deployment each region runs its own cluster behind its own hostname, and only
+// that cluster can act on the region's tickets and sessions. Empty api_endpoint
+// (the single-location default) means "use GAMIRA_API", so this is inert until
+// regions actually carry endpoints.
+let regionEndpoints: Record<string, string> | null = null;
+
+async function loadRegionEndpoints(token: string): Promise<Record<string, string>> {
+    if (regionEndpoints) return regionEndpoints;
+    const map: Record<string, string> = {};
+    try {
+        const res = await fetch(`${GAMIRA_API}/regions?limit=200`, { headers: { 'x-token': token } });
+        if (res.ok) {
+            const data = await res.json();
+            for (const r of data.items ?? []) {
+                if (r.api_endpoint) map[r.region_id] = r.api_endpoint;
+            }
+        }
+    } catch {
+        // Discovery is best-effort: without it every call uses GAMIRA_API, which
+        // is correct for a single-location deployment.
+    }
+    regionEndpoints = map;
+    return map;
+}
+
+async function baseFor(token: string, regionId?: string): Promise<string> {
+    if (!regionId) return GAMIRA_API;
+    const map = await loadRegionEndpoints(token);
+    return map[regionId] || GAMIRA_API;
+}
+
+async function gamiraFetch(
+    token: string,
+    path: string,
+    init?: RequestInit,
+    regionId?: string,
+): Promise<Response> {
+    const base = await baseFor(token, regionId);
+    const res = await fetch(`${base}${path}`, {
+        ...init,
+        headers: { ...(init?.headers || {}), 'x-token': token },
+    });
+    // 421 Misdirected Request: this cluster does not own the resource. The
+    // region map is stale (endpoint changed, or the resource moved), so drop it
+    // and retry once against a freshly resolved endpoint.
+    if (res.status === 421 && regionId) {
+        regionEndpoints = null;
+        const retryBase = await baseFor(token, regionId);
+        if (retryBase !== base) {
+            return fetch(`${retryBase}${path}`, {
+                ...init,
+                headers: { ...(init?.headers || {}), 'x-token': token },
+            });
+        }
+    }
+    return res;
+}
+
+async function asError(res: Response, op: string): Promise<Error> {
+    const body = await res.text().catch(() => '');
+    return new Error(`${op} ${res.status}: ${body || res.statusText}`);
+}
+
+export async function bootstrapPlayer(token: string): Promise<void> {
+    await gamiraFetch(token, '/players/me/bootstrap', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+    });
+}
+
+async function buildPingLatencies(token: string): Promise<Record<string, number>> {
+    const res = await gamiraFetch(token, '/regions?limit=200');
+    if (!res.ok) return {};
+    const data = await res.json();
+    const latencies: Record<string, number> = {};
+    for (const r of data.items ?? []) {
+        // Browser cannot ping UDP game server regions before connecting, so use a fixed placeholder.
+        latencies[r.region_id] = 50;
+    }
+    return latencies;
+}
+
+export async function createTicket(token: string): Promise<MatchmakingTicket> {
+    const ping_latencies = await buildPingLatencies(token);
+    const res = await gamiraFetch(token, '/matchmaking/tickets', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ game_mode_id: GAME_MODE_ID, ping_latencies }),
+    });
+    if (!res.ok) throw await asError(res, 'createTicket');
+    return res.json();
+}
+
+export async function getTicket(
+    token: string,
+    ticketId: string,
+    regionId?: string,
+): Promise<MatchmakingTicket> {
+    const res = await gamiraFetch(token, `/matchmaking/tickets/${ticketId}`, undefined, regionId);
+    if (!res.ok) throw await asError(res, 'getTicket');
+    return res.json();
+}
+
+export async function cancelTicket(token: string, ticketId: string, regionId?: string): Promise<void> {
+    await gamiraFetch(token, `/matchmaking/tickets/${ticketId}`, { method: 'DELETE' }, regionId);
+}
+
+export async function pollUntilMatched(
+    token: string,
+    ticketId: string,
+    timeoutMs = 30000,
+): Promise<MatchmakingTicket> {
+    const deadline = Date.now() + timeoutMs;
+    // The ticket names the region that owns it; follow-up polls go to that
+    // region's own API rather than whichever endpoint created it.
+    let regionId: string | undefined;
+    while (Date.now() < deadline) {
+        const ticket = await getTicket(token, ticketId, regionId);
+        regionId = ticket.region_id || regionId;
+        if (ticket.status === 'matched' && ticket.connection?.ip) return ticket;
+        if (ticket.status === 'cancelled') throw new Error('Ticket cancelled');
+        await new Promise((r) => setTimeout(r, 500));
+    }
+    throw new Error('Matchmaking timeout after 30s');
+}
